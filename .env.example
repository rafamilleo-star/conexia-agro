# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=https://goopogicgwqqovmphqrj.supabase.co
SUPABASE_SERVICE_KEY=
VITE_SUPABASE_URL=https://goopogicgwqqovmphqrj.supabase.co
VITE_SUPABASE_ANON_KEY=

# ── Gemini (AI/NLP do assistente de WhatsApp) ───────────────────
GEMINI_API_KEY=

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Cron ─────────────────────────────────────────────────────────
# Se definido, todos os endpoints de cron exigem Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# ── WhatsApp: Meta Cloud API (canal central de envio) ────────────
# O helper usa os IDs já provisionados como default quando ficam vazios.
# Defina apenas um alias, ou defina os dois com o mesmo valor; conflito é erro.
WHATSAPP_PROVIDER=meta
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_API_VERSION=v26.0
META_WEBHOOK_VERIFY_TOKEN=

# ── WhatsApp: credenciais legacy (mantidas para compatibilidade inbound) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
EVOLUTION_API_URL=https://evolution-api-production-0c6a.up.railway.app
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=conexia

# ── Assistente de Inteligência Relacional ───────────────────────
# meta é o canal ativo; webhook é legado e não envia silenciosamente por Twilio.
WEEKLY_SUMMARY_DEFAULT_HOUR=8
DEFAULT_TIMEZONE=America/Sao_Paulo

# Onboarding incompleto: horas de abandono até o 1º e o 2º lembrete
ONBOARDING_FIRST_REMINDER_HOURS=24
ONBOARDING_SECOND_REMINDER_HOURS=96

# Inatividade: dias sem acesso até o check-in, e cooldown entre check-ins
# repetidos (requer profiles.last_access_at populado pelo frontend — ver
# pendência no resumo de entrega)
INACTIVITY_DAYS_THRESHOLD=14
INACTIVITY_COOLDOWN_DAYS=21

# Atenção relacional: prioridade mínima (0-100) para disparar mensagem proativa
RELATIONSHIP_ATTENTION_MIN_PRIORITY=85

# ── OpenAI / Danna Live ─────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
